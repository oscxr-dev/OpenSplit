BITCOIN_RPC_USER=opensplit
BITCOIN_RPC_PASSWORD=opensplitpass
LND_AUTO_UNLOCK_PASSWORD=<CHANGE_ME>
LNBITS_SITE_TITLE=OpenSplit Dev
LNBITS_ADMIN_USER=admin
LNBITS_ADMIN_PASS=admin
LNBITS_SUPER_USER_ID=11111111111111111111111111111111
POSTGRES_USER=lnbits
POSTGRES_PASSWORD=lnbitspassword
POSTGRES_DB=orchestrator


# ── Orchestrator ──────────────────────────────────────────────────
# environment: development | staging | production
# In production the app FAILS TO START if any secret below is a default
# placeholder or if CORS allows "*".
ORCHESTRATOR_ENVIRONMENT=development
ORCHESTRATOR_JWT_SECRET=<CHANGE_ME>            # openssl rand -hex 32
ORCHESTRATOR_LNBITS_WEBHOOK_SECRET=<CHANGE_ME>
ORCHESTRATOR_SEED_ADMIN_PASSWORD=oscar123
# Comma-separated allowed origins (no "*" in production)
ORCHESTRATOR_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Base URL BTCPay uses to deliver webhooks to the orchestrator (shown in the
# guided webhook setup). Local default: the Docker host. In production it MUST
# be the public URL — the app refuses to start on a local-only host.
# ORCHESTRATOR_PUBLIC_BASE_URL=https://opensplit.example.com


# ── Dynamic LND receivers (demo payouts) ──────────────────────────────
# For split recipients whose LABEL matches LND_RECEIVER_<LABEL>_*, the
# orchestrator mints a fresh BOLT11 invoice for the exact split amount on the
# recipient's own LND node (REST API) and pays THAT invoice via BTCPay,
# instead of using a Lightning address. Leave unset to keep the LN-address
# path. Keep real values in a local untracked .env only.
#   <LABEL> is upper-cased; non-alphanumerics become "_" (e.g. Carol → CAROL).
# LND_RECEIVER_CAROL_URL=https://127.0.0.1:8080
# LND_RECEIVER_CAROL_MACAROON_HEX=<invoice.macaroon as hex>
# LND_RECEIVER_CAROL_TLS_CERT_HEX=<tls.cert PEM bytes as hex>
# LND_RECEIVER_DAVE_URL=https://127.0.0.1:8081
# LND_RECEIVER_DAVE_MACAROON_HEX=<invoice.macaroon as hex>
# LND_RECEIVER_DAVE_TLS_CERT_HEX=<tls.cert PEM bytes as hex>

SEED_ADMIN_EMAIL=oscar@admin.com
